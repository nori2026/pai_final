<?xml version="1.0" ?>
<!--
  PAI最終課題: AI人物追従ロボット用ワールド
  - Gazebo Fortress (ignition) + ROS 2 Humble 用
  - 差動二輪ロボット(カメラ付き) と 人モデル を配置
-->
<sdf version="1.8">
  <world name="follow_world">

    <!-- ===== 必須のシステムプラグイン ===== -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="libignition-gazebo-physics-system.so"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- カメラを動かすために必要（記事には無い追加部分） -->
    <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ===== 光源 ===== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ===== 地面（記事と同じ） ===== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== 追いかける対象: 人モデル（Gazebo Fuel, CC0ライセンス） =====
         初回起動時にインターネットから自動ダウンロードされます -->
    <include>
      <name>person</name>
      <pose>3.5 0.8 0 0 0 -1.57</pose>
      <uri>model://person_standing</uri>
      <static>true</static>
    </include>

    <!-- ===== 目印の障害物（動画で動きが分かりやすくなる） ===== -->
    <model name="box_red">
      <static>true</static>
      <pose>2.0 2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="box_blue">
      <static>true</static>
      <pose>2.0 -2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== ロボット本体: カメラ付き差動二輪ロボット ===== -->
    <model name="pai_robot">
      <pose>0 0 0 0 0 0</pose>

      <!-- 車体 -->
      <link name="base_link">
        <pose>0 0 0.1 0 0 0</pose>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.0108</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0175</iyy><iyz>0</iyz><izz>0.0242</izz>
          </inertia>
        </inertial>
        <visual name="base_visual">
          <geometry><box><size>0.30 0.22 0.08</size></box></geometry>
          <material><ambient>0.1 0.6 0.9 1</ambient><diffuse>0.1 0.6 0.9 1</diffuse></material>
        </visual>
        <collision name="base_collision">
          <geometry><box><size>0.30 0.22 0.08</size></box></geometry>
        </collision>
      </link>

      <!-- 左車輪（記事と同じ考え方: link + revolute joint） -->
      <link name="wheel_left_link">
        <pose>0.05 0.13 0.05 -1.5707 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.00013</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00013</iyy><iyz>0</iyz><izz>0.00025</izz>
          </inertia>
        </inertial>
        <visual name="v">
          <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        </collision>
      </link>

      <!-- 右車輪 -->
      <link name="wheel_right_link">
        <pose>0.05 -0.13 0.05 -1.5707 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.00013</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00013</iyy><iyz>0</iyz><izz>0.00025</izz>
          </inertia>
        </inertial>
        <visual name="v">
          <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        </collision>
      </link>

      <!-- 後ろのキャスター（摩擦ゼロの球） -->
      <link name="caster_link">
        <pose>-0.11 0 0.025 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz>
          </inertia>
        </inertial>
        <visual name="v">
          <geometry><sphere><radius>0.025</radius></sphere></geometry>
          <material><ambient>0.2 0.9 0.2 1</ambient><diffuse>0.2 0.9 0.2 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><sphere><radius>0.025</radius></sphere></geometry>
          <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
      </link>

      <!-- カメラ（AIの「目」。記事には無い追加部分） -->
      <link name="camera_link">
        <!-- 少し上向き(pitch=-0.2rad)にして、近づいても人の全身が映るようにする -->
        <pose>0.14 0 0.20 0 -0.2 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz>
          </inertia>
        </inertial>
        <visual name="v">
          <geometry><box><size>0.04 0.08 0.04</size></box></geometry>
          <material><ambient>0.9 0.9 0.1 1</ambient><diffuse>0.9 0.9 0.1 1</diffuse></material>
        </visual>
        <sensor name="front_camera" type="camera">
          <camera>
            <horizontal_fov>1.3</horizontal_fov>  <!-- 約75度: 広めにして見失いにくくする -->
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>50</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>15</update_rate>
          <visualize>true</visualize>
          <topic>camera</topic>
        </sensor>
      </link>

      <!-- ===== ジョイント ===== -->
      <joint name="wheel_left_joint" type="revolute">
        <parent>base_link</parent>
        <child>wheel_left_link</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <joint name="wheel_right_joint" type="revolute">
        <parent>base_link</parent>
        <child>wheel_right_link</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <joint name="caster_joint" type="ball">
        <parent>base_link</parent>
        <child>caster_link</child>
      </joint>
      <joint name="camera_joint" type="fixed">
        <parent>base_link</parent>
        <child>camera_link</child>
      </joint>

      <!-- ===== 差動二輪プラグイン（記事と同じ。/cmd_vel を受けて動く） ===== -->
      <plugin filename="libignition-gazebo-diff-drive-system.so"
              name="ignition::gazebo::systems::DiffDrive">
        <left_joint>wheel_left_joint</left_joint>
        <right_joint>wheel_right_joint</right_joint>
        <wheel_separation>0.26</wheel_separation>
        <wheel_radius>0.05</wheel_radius>
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
      </plugin>
    </model>

  </world>
</sdf>
